# ============================================================
#  Konfigurasi RailLive
#  Salin file ini menjadi .env.local untuk pengembangan lokal.
#  Untuk produksi (Vercel), isi lewat:
#  Project → Settings → Environment Variables
# ============================================================

# Pilih sumber data: "mock" (default, tanpa API key) atau "rajakai".
DATA_PROVIDER=mock

# --- Hanya diperlukan bila DATA_PROVIDER=rajakai ---
# Ganti nilai di bawah sesuai dokumentasi resmi RajaKAI Anda.
RAJAKAI_BASE_URL=https://api.rajakai.com
RAJAKAI_API_KEY=
# Nama header untuk mengirim API key (mis. X-API-Key, Authorization).
RAJAKAI_AUTH_HEADER=X-API-Key
